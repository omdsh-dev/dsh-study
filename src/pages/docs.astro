---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const B = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const cats = [...new Set(docs.map((d) => d.data.category))];
const CAT_DESC: Record<string, string> = {
  '入门': '第一次接触 dsh，从这里开始（建议按顺序读）。',
  '架构': '理解 dsh 的设计、数据模型与运行时。',
  '工程实践': '值得抄走的开发流程与治理机制。',
  '参与': '跑起来、写插件、程序化接入。',
};
---
<Base active="/docs/" title="文档导读 · dsh-study">
  <div class="page-hero">
    <div class="wrap">
      <h1>文档导读 <span class="accent">Guides</span></h1>
      <p>为 dsh 的重要文档写的中文导读：它讲什么、为什么重要、怎么读。导读不是翻译，读完请一定点原文。</p>
    </div>
  </div>
  <div class="section wrap">
    {cats.map((cat) => (
      <section style="margin-bottom:44px">
        <h2 class="section-title">{cat}</h2>
        <p class="section-sub">{CAT_DESC[cat] ?? ''}</p>
        <div class="doc-grid">
          {docs.filter((d) => d.data.category === cat).map((d) => (
            <a class="card doc-card" href={`${B}docs/${d.id.replace(/\.md$/, '')}/`}>
              <h3>{d.data.title}</h3>
              <p>{d.data.summary}</p>
              <p style="margin-top:10px"><span class="chip mono">{d.data.doc}</span></p>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>
